<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>art\app.ico</ApplicationIcon>
    <AssemblyTitle>UGreen Capture Viewer</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DirectShowLib.Standard" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="art\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="art\app.png" LogicalName="app.png" />
    <EmbeddedResource Include="art\nosignal.jpg" LogicalName="nosignal.jpg" />
    <None Remove="art\**" />
    <Compile Remove="tools\**" />
  </ItemGroup>

</Project>
